{
  "name": "@leadtech/website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @leadtech/contracts build",
    "build": "next build",
    "check": "pnpm --filter . run --parallel \"/^check:(format|lint|typecheck)$/\"",
    "check:format": "prettier --check . --ignore-path ../../.prettierignore",
    "check:lint": "eslint .",
    "check:typecheck": "tsc --noEmit",
    "dev": "next dev --port 3000",
    "start": "next start --port 3000"
  },
  "dependencies": {
    "@leadtech/contracts": "workspace:*",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
