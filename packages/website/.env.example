# ——————————————————————————————————————————————————————————————————————————
# ——— Website: Public origins used for routing and search metadata

# Use   : Trusted absolute origin for registration and sign-in links.
# Source: The deployed @leadtech/app origin.
# Path  : Deployment > Domains > Application origin
# E.g.  : http://localhost:3001
NEXT_PUBLIC_APP_URL=

# Use   : Canonical absolute origin for metadata, robots, and sitemap URLs.
# Source: The deployed @leadtech/website origin.
# Path  : Deployment > Domains > Marketing origin
# E.g.  : http://localhost:3000
NEXT_PUBLIC_SITE_URL=
