# ——————————————————————————————————————————————————————————————————————————
# ——— Stripe: Integration tests

# Use   : Creates sandbox resources and initializes Stripe for webhook tests.
# Source: Stripe sandbox restricted API key with Customers and Checkout write/read access.
# Path  : Stripe Dashboard > Developers > API keys > Create restricted key
# E.g.  : rk_test_...
STRIPE_API_KEY=

# Use   : Signs and validates webhook payloads in the Functions emulator.
# Source: A developer-selected local test value.
# Path  : packages/tests > .secret.local
# E.g.  : whsec_local_test_value
STRIPE_WEBHOOK_SIGNING_SECRET=
