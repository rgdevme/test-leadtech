# —————————————————————————————————————————————————————————————————————————————
# ——— Firebase: Local Functions runtime

# Use   : Identifies the non-production project used by the Emulator Suite.
# Source: Local Firebase CLI demo project.
# Path  : firebase.json > Emulator Suite
# E.g.  : demo-leadtech
GCLOUD_PROJECT=demo-leadtech

# —————————————————————————————————————————————————————————————————————————————
# ——— Stripe: Sandbox webhook configuration

# Use   : Authenticates Stripe sandbox API calls from Firebase Functions.
# Source: Stripe sandbox restricted API key.
# Path  : Stripe Dashboard > Developers > API keys
# E.g.  : Leave empty until the Stripe sandbox is provisioned.
STRIPE_RESTRICTED_KEY=

# Use   : Verifies webhook signatures forwarded by the Stripe CLI.
# Source: Stripe CLI webhook forwarding session.
# Path  : stripe listen > Ready output
# E.g.  : Leave empty until webhook implementation begins.
STRIPE_WEBHOOK_SECRET=
