{
  "name": "@leadtech/functions",
  "version": "0.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "check": "pnpm --filter . run --parallel \"/^check:(format|lint|typecheck)$/\"",
    "check:format": "prettier --check . --ignore-path ../../.prettierignore",
    "check:lint": "eslint .",
    "check:typecheck": "tsc --noEmit",
    "dev": "pnpm build && pnpm --dir ../.. exec firebase emulators:start --project demo-leadtech",
    "start": "node lib/index.js"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0",
    "typescript": "^5.9.3"
  }
}
