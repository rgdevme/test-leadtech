{
	"name": "@leadtech/functions",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "lib/index.js",
	"engines": {
		"node": "22"
	},
	"scripts": {
		"prebuild": "pnpm --filter @leadtech/common build",
		"build": "tsc",
		"check": "pnpm --filter . run --parallel \"/^check:(format|lint|typecheck)$/\"",
		"check:format": "prettier --check . --ignore-path ../../.prettierignore",
		"check:lint": "eslint .",
		"check:typecheck": "tsc --noEmit",
		"dev": "conc \"pnpm:dev:*\"",
		"dev:functions": "pnpm build && pnpm --dir ../.. exec firebase emulators:start",
		"dev:stripe": "stripe listen --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed --forward-to http://127.0.0.1:5001/job-application-test-8e837/us-central1/stripeWebhook",
		"start": "pnpm dev"
	},
	"dependencies": {
		"@leadtech/common": "workspace:*",
		"firebase-admin": "^14.2.0",
		"firebase-functions": "^7.3.2",
		"stripe": "^22.5.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^26.2.0",
		"concurrently": "^10.0.4",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0"
	}
}
