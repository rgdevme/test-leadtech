# —————————————————————————————————————————————————————————————————————————————
# ——— Firebase: Local SDK configuration for the Firebase Emulator Suite

# Use   : Identifies the local web app to the Firebase Web SDK.
# Source: Local-only demo configuration; no Firebase account is required.
# Path  : Firebase Emulator Suite > Web SDK
# E.g.  : demo-api-key
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key

# Use   : Supplies the local auth domain expected by the Firebase Web SDK.
# Source: Derived from the demo project ID below.
# Path  : Firebase Emulator Suite > Authentication
# E.g.  : demo-leadtech.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-leadtech.firebaseapp.com

# Use   : Keeps every Firebase request inside a non-production demo project.
# Source: Local Firebase CLI demo project.
# Path  : firebase.json > Emulator Suite
# E.g.  : demo-leadtech
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-leadtech
FIREBASE_PROJECT_ID=demo-leadtech
GCLOUD_PROJECT=demo-leadtech

# Use   : Completes the Firebase Web SDK configuration without real resources.
# Source: Local-only demo configuration; these values are not credentials.
# Path  : Firebase Emulator Suite > Web SDK
# E.g.  : demo-leadtech.firebasestorage.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-leadtech.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Use   : Routes browser Authentication SDK traffic to the local emulator.
# Source: firebase.json emulator ports.
# Path  : Firebase Emulator Suite > Authentication
# E.g.  : 127.0.0.1 and 9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099

# Use   : Routes browser Firestore SDK traffic to the local emulator.
# Source: firebase.json emulator ports.
# Path  : Firebase Emulator Suite > Firestore
# E.g.  : 127.0.0.1 and 8080
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080

# Use   : Routes Firebase Admin SDK traffic from Next.js to local emulators.
# Source: firebase.json emulator ports.
# Path  : Firebase Emulator Suite > Authentication and Firestore
# E.g.  : 127.0.0.1:9099 and 127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# —————————————————————————————————————————————————————————————————————————————
# ——— Stripe: Sandbox subscription configuration

# Use   : Authenticates server-side Stripe sandbox requests.
# Source: Stripe sandbox restricted API key.
# Path  : Stripe Dashboard > Developers > API keys
# E.g.  : Leave empty until the Stripe sandbox is provisioned.
STRIPE_RESTRICTED_KEY=

# Use   : Selects the recurring sandbox price used by Checkout.
# Source: Stripe sandbox product price.
# Path  : Stripe Dashboard > Product catalog > Product > Pricing
# E.g.  : Leave empty until the Stripe sandbox is provisioned.
STRIPE_PRICE_ID=

# —————————————————————————————————————————————————————————————————————————————
# ——— Application: Local URLs

# Use   : Builds local callbacks and redirects.
# Source: Local Next.js development server.
# Path  : packages/app > dev script
# E.g.  : http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
