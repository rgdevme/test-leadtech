# —————————————————————————————————————————————————————————————————————————————
# ——— Stripe: Sandbox subscription configuration

# Use   : Authenticates server-side Stripe sandbox Checkout and Customer requests.
# Source: Stripe sandbox restricted API key.
# Path  : Stripe Dashboard > Developers > API keys
# E.g.  : rk_test_...
STRIPE_API_KEY=

# —————————————————————————————————————————————————————————————————————————————
# ——— Application: Local URLs

# Use   : Validates mutation origins and builds Stripe return URLs.
# Source: The deployed application origin or local Next.js development server.
# Path  : Deployment settings > Environment variables
# E.g.  : http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ——————————————————————————————————————————————————————————————————————————
# ——— Firebase: Local Emulator Suite

# Use   : Routes server-side Firebase Authentication requests to the local emulator.
# Source: The Authentication emulator configured in firebase.json.
# Path  : firebase.json > emulators > auth > port
# E.g.  : 127.0.0.1:9099
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Use   : Routes server-side Cloud Firestore requests to the local emulator.
# Source: The Cloud Firestore emulator configured in firebase.json.
# Path  : firebase.json > emulators > firestore > port
# E.g.  : 127.0.0.1:8080
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
