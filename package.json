{
  "name": "leadtech",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --parallel build",
    "check": "pnpm -r --parallel check",
    "check:format": "pnpm -r --parallel check:format",
    "check:lint": "pnpm -r --parallel check:lint",
    "check:typecheck": "pnpm -r --parallel check:typecheck",
    "dev": "pnpm -r --parallel dev",
    "dev:apps": "pnpm --parallel --filter @leadtech/website --filter @leadtech/app dev",
    "dev:functions": "pnpm --filter @leadtech/functions dev",
    "start": "pnpm -r --parallel start"
  },
  "devDependencies": {
    "@luxia/agnos": "^1.1.1",
    "firebase-tools": "^15.26.0",
    "typescript": "^5.9.3"
  }
}
