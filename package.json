{
  "name": "leadtech",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @leadtech/website --filter @leadtech/app --filter @leadtech/functions dev",
    "dev:apps": "pnpm --parallel --filter @leadtech/website --filter @leadtech/app dev",
    "dev:functions": "pnpm --filter @leadtech/functions dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@luxia/agnos": "^1.1.1",
    "firebase-tools": "^15.26.0",
    "typescript": "^5.9.3"
  }
}