{
	"$schema": "https://turborepo.com/schema.json",
	"remoteCache": {
		"enabled": true
	},
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
		},
		"check": {
			"dependsOn": ["check:format", "check:lint", "check:typecheck"]
		},
		"check:format": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/.prettierignore",
				"$TURBO_ROOT$/.prettierrc.json"
			],
			"outputs": []
		},
		"check:lint": {
			"outputs": []
		},
		"check:typecheck": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"test:provider": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"verify": {
			"dependsOn": ["build", "check", "test"]
		}
	}
}
