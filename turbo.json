{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "lib/**"]
    },
    "check:format": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check:lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check:typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
